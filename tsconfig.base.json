{
  "compilerOptions": {
    /* Lenguaje */
    "strict": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Módulos */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,

    /* Aliases compartidos */
    "paths": {
      "@packages/*": ["./packages/*/src"],
      "@packages/types/*": ["./packages/types/src/*"]
    }
  }
}
