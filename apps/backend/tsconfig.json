{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": ".",
    "types": [
      "node",
      "jest"
    ],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "Node16"
  },
  "include": [
    "src/**/*",
    "prisma.config.ts",
    "prisma/**/*.ts"
  ]
}
