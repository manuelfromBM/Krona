{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react",
    "strict": true,
    "target": "ES2019",
    "lib": [
      "ES2019",
      "DOM"
    ],
    "noEmit": true,
    "paths": {
      "@packages/*": [
        "../../packages/*/src"
      ],
      "src/*": [
        "./src/*"
      ],
      "@packages/types/*": [
        "../../packages/types/src/*"
      ]
    },
    "rootDir": "../.."
  },
  "include": [
    "src/**/*",
    "src",
    "App.tsx",
    "index.ts"
  ]
}
