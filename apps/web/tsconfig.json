{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@packages/services": [
        "../../packages/services/src"
      ],
      "@packages/services/*": [
        "../../packages/services/src/*"
      ],
      "@packages/types": [
        "../../packages/types/src"
      ],
      "@packages/types/*": [
        "../../packages/types/src/*"
      ],
      "@packages/hooks/*": [
        "../../packages/hooks/src/*"
      ]
    },
    "rootDir": "../.."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
