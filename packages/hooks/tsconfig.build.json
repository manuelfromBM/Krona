{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "target": "ES2019",
    "noEmit": false,
    "paths": {
      "@packages/types": [
        "../types/lib"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "lib"
  ]
}
