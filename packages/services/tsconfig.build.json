{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "target": "ES2019",
    "moduleResolution": "Bundler"
  },
  "exclude": [
    "node_modules",
    "lib"
  ]
}
