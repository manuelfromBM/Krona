{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "target": "ES2017",
    "lib": [
      "DOM",
      "ES2017"
    ],
    "module": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "moduleResolution": "Node16",
    "rootDir": "./src",
    "isolatedModules": true
  },
  "include": [
    "src"
  ]
}
