{
  "compilerOptions": {
    "outDir": "lib",          // Carpeta donde se generará JS
    "rootDir": "src",//
    "module": "ESNext",//
    "target": "ES6",//
    "declaration": true,      // Para generar .d.ts
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react",//
    "moduleResolution": "node",
    "esModuleInterop": true,//
    "skipLibCheck": true,
    "strict": true//
  },
  "include": ["src/**/*.ts","src/**/*.tsx"],
  "exclude": ["node_modules","lib"]
}
